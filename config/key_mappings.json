{
  "profiles": {
    "edit": {
      "name": "BMSpeedEditor-Edit",
      "description": "Edit mode with jog wheel support for parameter adjustment",
      "mappings": {
        "TIMELINE": {
          "type": "PROFILE",
          "target_profile": "edit",
          "actions": {
            "press": "SwToMdevelop"
          }
        },
        "STOP_PLAY": {
          "type": "SINGLE",
          "actions": {
            "press": "AutoTone"
          }
        },
        "CAM1": {
          "type": "JOG",
          "actions": {
            "double_tap": "ResetTexture",
            "jog": "Texture"
          }
        },
        "CAM2": {
          "type": "JOG",
          "actions": {
            "double_tap": "ResetClarity",
            "jog": "Clarity"
          }
        },
        "CAM3": {
          "type": "JOG",
          "actions": {
            "double_tap": "ResetDehaze",
            "jog": "Dehaze"
          }
        },
        "CAM4": {
          "type": "JOG",
          "actions": {
            "double_tap": "ResetShadows",
            "jog": "Shadows"
          }
        },
        "CAM5": {
          "type": "JOG",
          "actions": {
            "double_tap": "ResetWhites",
            "jog": "Whites"
          }
        },
        "CAM6": {
          "type": "JOG",
          "actions": {
            "double_tap": "ResetBlacks",
            "jog": "Blacks"
          }
        },
        "CAM7": {
          "type": "JOG",
          "actions": {
            "double_tap": "ResetExposure",
            "jog": "Exposure"
          }
        },
        "CAM8": {
          "type": "JOG",
          "actions": {
            "double_tap": "ResetContrast",
            "jog": "Contrast"
          }
        },
        "CAM9": {
          "type": "JOG",
          "actions": {
            "double_tap": "ResetHighlights",
            "jog": "Highlights"
          }
        },
        "SOURCE": {
          "type": "PROFILE",
          "target_profile": "library",
          "actions": {
            "press": "SwToMlibrary"
          }
        },
        "ROLL": {
          "type": "SINGLE",
          "actions": {
            "press": "Reject"
          }
        },
        "TRIM_OUT": {
          "type": "SINGLE",
          "actions": {
            "press": "RemoveFlag"
          }
        },
        "TRIM_IN": {
          "type": "SINGLE",
          "actions": {
            "press": "Pick"
          }
        },
        "OUT": {
          "type": "SINGLE",
          "actions": {
            "press": "Next"
          }
        },
        "IN": {
          "type": "SINGLE",
          "actions": {
            "press": "Prev"
          }
        },
        "CUT": {
          "type": "TOGGLE",
          "actions": {
            "on": "ToggleZoomOffOn",
            "off": "ToggleZoomOffOn"
          }
        }
      }
    },
    "library": {
      "name": "BMSpeedEditor-Library",
      "description": "Library mode for photo browsing and selection",
      "mappings": {
        "PLACE_ON_TOP": {
          "type": "SINGLE",
          "actions": {
            "press": "Key1"
          }
        },
        "SMART_INSRT": {
          "type": "SINGLE",
          "actions": {
            "press": "ShoVwloupe"
          }
        },
        "APPND": {
          "type": "SINGLE",
          "actions": {
            "press": "ShoVwcompare"
          }
        },
        "AUDIO_LEVEL": {
          "type": "SINGLE",
          "actions": {
            "press": "ShoVwcompare"
          }
        },
        "RIPL_OWR": {
          "type": "SINGLE",
          "actions": {
            "press": "ShoVwsurvey"
          }
        },
        "RIPL_DEL": {
          "type": "SINGLE",
          "actions": {
            "press": "ShoFullPreview"
          }
        },
        "FULL_VIEW": {
          "type": "SINGLE",
          "actions": {
            "press": "ToggleZoomOffOn"
          }
        },
        "TRIM_IN": {
          "type": "SINGLE",
          "actions": {
            "press": "Pick"
          }
        },
        "SOURCE": {
          "type": "PROFILE",
          "target_profile": "library",
          "actions": {
            "press": "SwToMlibrary"
          }
        },
        "ROLL": {
          "type": "SINGLE",
          "actions": {
            "press": "Reject"
          }
        },
        "TRIM_OUT": {
          "type": "SINGLE",
          "actions": {
            "press": "RemoveFlag"
          }
        },
        "CLOSE_UP": {
          "type": "SINGLE",
          "actions": {
            "press": "Select1Left"
          }
        },
        "SRC_OWR": {
          "type": "SINGLE",
          "actions": {
            "press": "Select1Right"
          }
        },
        "OUT": {
          "type": "SINGLE",
          "actions": {
            "press": "Next"
          }
        },
        "IN": {
          "type": "SINGLE",
          "actions": {
            "press": "Prev"
          }
        },
        "CUT": {
          "type": "TOGGLE",
          "actions": {
            "on": "ToggleZoomOffOn",
            "off": "ToggleZoomOffOn"
          }
        },
        "TIMELINE": {
          "type": "PROFILE",
          "target_profile": "edit",
          "actions": {
            "press": "SwToMdevelop"
          }
        },
        "STOP_PLAY": {
          "type": "SINGLE",
          "actions": {
            "press": "AutoTone"
          }
        }
      }
    }
  },
  "jog_modes": {
    "SHTL": {
      "led": "SHTL",
      "mode": "ABSOLUTE_DEADZERO"
    },
    "JOG": {
      "led": "JOG",
      "mode": "RELATIVE_2"
    },
    "SCRL": {
      "led": "SCRL",
      "mode": "RELATIVE_2"
    }
  }
}
